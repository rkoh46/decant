<UserControl
    x:Class="Decant.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Decant.Views"
    AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop" DragLeave="Page_DragLeave">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Toolbar: search, sort, system apps, count, install, refresh -->
        <Grid Padding="12,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBox x:Name="Search" PlaceholderText="Search apps" Width="240" FontSize="12" MinHeight="26" Padding="8,3" TextChanged="Search_TextChanged" />
                <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                    <StackPanel x:Name="SortBar" Orientation="Horizontal" Spacing="2">
                        <Button Content="Size" Tag="size" FontSize="12" Padding="10,2" MinHeight="22" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="Sort_Click" />
                        <Button Content="Data" Tag="data" FontSize="12" Padding="10,2" MinHeight="22" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="Sort_Click" />
                        <Button Content="Name" Tag="name" FontSize="12" Padding="10,2" MinHeight="22" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="Sort_Click" />
                        <Button Content="Added" Tag="date" FontSize="12" Padding="10,2" MinHeight="22" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="Sort_Click" ToolTipService.ToolTip="Added is the App Store purchase date; iOS does not report the install date" />
                    </StackPanel>
                </Border>
                <CheckBox x:Name="SystemApps" Content="Include system apps" FontSize="12" MinWidth="0" Checked="SystemApps_Toggled" Unchecked="SystemApps_Toggled" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <Button x:Name="InstallButton" Content="Install .ipa…" FontSize="12" Padding="10,3" Click="Install_Click" />
                <Button x:Name="RefreshButton" FontSize="12" Padding="7,4" Click="Refresh_Click" ToolTipService.ToolTip="Reload">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>
        <!-- App list -->
        <ListView x:Name="List" Grid.Row="1" SelectionMode="None" Padding="12,8" IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="MinHeight" Value="49" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:AppRow">
                    <Grid ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="7" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <Grid>
                                <FontIcon Glyph="{x:Bind PlaceholderGlyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind PlaceholderVisible}" />
                                <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="Medium" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind BundleId}" />
                        </StackPanel>
                        <!-- One TextBlock with two runs: two stacked TextBlocks here made WinUI pin the whole window to the Light theme. -->
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Visibility="{x:Bind SizeVisible}">
                            <Run Text="{x:Bind Total}" FontSize="13" /><LineBreak /><Run Text="{x:Bind SizeDetail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="…" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Visibility="{x:Bind MeasuringVisible}" />
                        <Button Grid.Column="3" Content="Files" FontSize="12" Padding="10,3" VerticalAlignment="Center" Visibility="{x:Bind FilesVisible}" Click="Files_Click" ToolTipService.ToolTip="Browse this app's documents" />
                        <Button Grid.Column="4" Content="Uninstall…" FontSize="12" Padding="10,3" VerticalAlignment="Center" IsEnabled="{x:Bind CanUninstall}" Click="Uninstall_Click" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <!-- Not ready / loading -->
        <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon Glyph="&#xE71D;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel x:Name="LoadingPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <ProgressRing IsActive="True" Width="24" Height="24" />
            <TextBlock Text="Reading apps…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>
        <!-- Drop overlay -->
        <Border x:Name="DropOverlay" Grid.Row="1" Margin="8" CornerRadius="12" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="Drop an .ipa to install it" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <!-- Status bar -->
        <Grid x:Name="StatusBar" Grid.Row="2" Height="40" Padding="16,0" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing x:Name="StatusSpinner" IsActive="True" Width="16" Height="16" Visibility="Collapsed" />
                <ProgressBar x:Name="StatusProgress" Width="320" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
